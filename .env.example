# PostgreSQL connection string (Railway provides postgresql://...). Leave unset to use local SQLite.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Optional shared secret; if set, /vapi/webhook requires header x-vapi-secret to match.
VAPI_SECRET=change-me
# Optional log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Optional: insert two fictional demo patients on startup if the table is empty
SEED_DEMO_DATA=false
